{
  "name": "promptfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Promptfolio: a resume that boots to a terminal. JSON Resume in; Tabby-inspired site, print view, JSON API and a container out.",
  "author": "Chris Russell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xerodok/promptfolio"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "docker:build": "docker build -t promptfolio:local .",
    "docker:run": "docker run --rm -p 3000:3000 promptfolio:local",
    "export:static": "node scripts/static-export.mjs .next out/static",
    "content:private": "sh scripts/use-content.sh private",
    "content:sample": "sh scripts/use-content.sh sample"
  },
  "dependencies": {
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "minimatch@<11.0.1": "^11.0.1"
    }
  }
}
